From b63867a656fa85857dc3a546a00556773dafcc7a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 8 Nov 2026 18:13:03 -0300
Subject: [PATCH 1/2] Kaizo: leftover starter, trainer rematches, random
 fast-hatching eggs
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- aspertia_city.s: no selection screen; the starter is picked at random as Hugh's
  counter, so the rival's team still matches
- global_3000.s: talking to a Trainer always starts a battle, even a won one
- scrcmd_pokemon.c: PokePartyAddEgg with species 0 gives an egg of a random
  breedable Pokémon's baby form, and every scripted egg hatches in one cycle

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01RsgtwK2jnQXoVqYskiNWWi
---
 res/field/scripts/aspertia_city.s | 11 +++--------
 res/field/scripts/global_3000.s   |  3 ++-
 src/ov012/scrcmd_pokemon.c        | 22 ++++++++++++++++++++++
 3 files changed, 27 insertions(+), 9 deletions(-)

diff --git a/res/field/scripts/aspertia_city.s b/res/field/scripts/aspertia_city.s
index 64cba7b4b..b7b0d9783 100644
--- a/res/field/scripts/aspertia_city.s
+++ b/res/field/scripts/aspertia_city.s
@@ -363,15 +363,10 @@ L_0538:
     // "Bianca: OK, then![f000]븁\u0000\nTa-daaa![f000]븁\u0000\nIn here is the Pokémon\nthat will be your partner![f000]븁\u0000"
     ActorMsg MSGFILE_SCRIPT, AspertiaCity_Text_BiancaOkThenTa, 2, 1, 0
     MsgWinCloseAll
-    WorkSetConst 0x8024, 0
+    // Kaizo: no selection screen. Hugh picks first, at random, and the player gets the starter
+    // that his pick beats (0 Snivy, 1 Tepig, 2 Oshawott), so the rival's team still matches
+    Random 0x8024, 3
     WorkSetConst 0x8025, 0
-    FadeOutBlackQ
-    FadeWait
-    FieldClose
-    callPoke3Select 0x8024
-    FieldOpen
-    FadeInWhiteQ
-    FadeWait
     VMStackPush 0x8024
     VMStackPushConst 0
     VMStackCmp CMP_EQ
diff --git a/res/field/scripts/global_3000.s b/res/field/scripts/global_3000.s
index 78f81c11d..6a15df9f4 100644
--- a/res/field/scripts/global_3000.s
+++ b/res/field/scripts/global_3000.s
@@ -832,7 +832,8 @@ Script_816:
     ActorSetEyeToEye
     VMCall L_0F57
     ActorGetTrainerID 0x8020
-    TrainerFlagGet 0x8020, 0x8010
+    // Kaizo: talking to a Trainer always starts a battle, even one already won
+    WorkSetConst 0x8010, 0
     VMStackPush 0x8010
     VMStackPushConst 1
     VMStackCmp CMP_EQ
diff --git a/src/ov012/scrcmd_pokemon.c b/src/ov012/scrcmd_pokemon.c
index 4760cd04f..f42419ae0 100644
--- a/src/ov012/scrcmd_pokemon.c
+++ b/src/ov012/scrcmd_pokemon.c
@@ -1,15 +1,19 @@
 // Names from swan (https://github.com/ds-pokemon-hacking/swan, GPL-3.0). swan gives wf_location, stats_list and iv_set
 // one byte after each table, and calls iv_set's second column iv_val
 #include "types.h"
+#include "constants/arc.h"
 #include "constants/places.h"
 #include "constants/pokemon.h"
+#include "constants/species.h"
 #include "field/field.h"
 #include "field/field_script.h"
 #include "field/player_state.h"
 #include "field/scrcmd_pokemon.h"
 #include "field/zone.h"
+#include "gfl/arc.h"
 #include "gfl/heap.h"
 #include "gfl/msg.h"
+#include "gfl/random.h"
 #include "gfl/std.h"
 #include "gfl/str.h"
 #include "pml/item.h"
@@ -882,6 +886,18 @@ BOOL Scrcmd_Pokemon_BoxAddEx(VM *vm, FieldScriptEnv *env) {
     return FALSE;
 }
 
+// Kaizo: the species of an egg for a random Pokémon that can breed (so no legendaries), as its baby form
+static u16 PickRandomEggSpecies(void) {
+    u16 species;
+    u16 baby;
+
+    do {
+        species = GFL_RandomLC(SPECIES_GENESECT - 1) + 1;
+    } while (PML_PersonalGetParamSingle(species, 0, PERSONAL_EGG_GROUP_1) == EGG_GROUP_UNDISCOVERED);
+    GFL_ArcSysReadRange(&baby, ARCID_BABYMONS, species, 0, 2);
+    return baby;
+}
+
 BOOL Scrcmd_Pokemon_PokePartyAddEgg(VM *vm, FieldScriptEnv *env) {
     GameData *gameData;
     HeapID heapId;
@@ -907,6 +923,10 @@ BOOL Scrcmd_Pokemon_PokePartyAddEgg(VM *vm, FieldScriptEnv *env) {
         *result = FALSE;
         return FALSE;
     }
+    if (species == SPECIES_NONE) {
+        species = PickRandomEggSpecies();
+        form = 0;
+    }
     pkm = PokeParty_NewTempPkm(species, 1, (u64)-1, heapId);
     PokeParty_SetParam(pkm, PKM_PARAM_FORM, form);
     name = copyTrainerNameToNewStrbuf((const u16 *)GetGameDataPlayerInfo(gameData), heapId);
@@ -916,6 +936,8 @@ BOOL Scrcmd_Pokemon_PokePartyAddEgg(VM *vm, FieldScriptEnv *env) {
                                 PokeParty_GetParam(pkm, PKM_PARAM_FORM, NULL), heapId);
     cycles = PML_PersonalGetParam(personal, PERSONAL_HATCH_CYCLES);
     PML_PersonalFree(personal);
+    // Kaizo: every egg given by a script hatches after one cycle
+    cycles = 1;
     PokeParty_SetParam(pkm, PKM_PARAM_HAPPINESS, cycles);
     PokeParty_SetParam(pkm, PKM_PARAM_IS_EGG, 1);
     name = GFL_MsgDataLoadStrbufNew(g_PMLSpeciesNamesResident, SPECIES_EGG);
-- 
2.43.0


